# Copy to .env and replace the password and token placeholders with independent random hex strings.
# Generate values with: openssl rand -hex 24
POSTGRES_USER=job
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_DB=job_recovery
DATABASE_URL=postgres://job:replace_with_random_hex_password@127.0.0.1:5432/job_recovery?sslmode=disable
COMPOSE_DATABASE_URL=postgres://job:replace_with_random_hex_password@postgres:5432/job_recovery?sslmode=disable
NATS_URL=nats://127.0.0.1:4222
HTTP_ADDR=127.0.0.1:8080
WORKER_ID=worker-local
JOB_LEASE_DURATION=15s
JOB_HEARTBEAT_INTERVAL=3s
NATS_ACK_WAIT=30s
POLL_INTERVAL=1s
ADMIN_TOKEN=replace_with_random_hex_admin_token
DEMO_MODE_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_TIMEOUT=20s
DISPATCH_REPAIR_INTERVAL=60s
DB_MAX_CONNECTIONS=20
DB_QUERY_TIMEOUT=5s
